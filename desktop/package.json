{
  "name": "little-steps-planner-desktop",
  "version": "1.0.0",
  "description": "Personal offline life and money planner for Windows",
  "productName": "Little Steps Planner",
  "private": true,
  "author": "Little Steps",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:windows": "electron-builder --win nsis portable --x64 --publish never"
  },
  "build": {
    "appId": "com.littlesteps.planner",
    "productName": "Little Steps Planner",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "../windows-release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "activation.html",
      "activation.js",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Little-Steps-Planner-Setup-${version}-x64.exe"
    },
    "portable": {
      "artifactName": "Little-Steps-Planner-Portable-${version}-x64.exe"
    }
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  }
}
